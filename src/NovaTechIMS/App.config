<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Password is NOT stored here.
      Set user environment variable NOVATECH_PG_PASSWORD.
      Optional full override: NOVATECH_IMS_CONNECTION.
    -->
    <add name="NovaTechIMS"
         connectionString="Host=localhost;Port=5432;Database=NovaTechIMS;Username=postgres"
         providerName="Npgsql" />
  </connectionStrings>
</configuration>
