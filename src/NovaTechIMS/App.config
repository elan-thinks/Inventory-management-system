<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Update Username/Password to match your local PostgreSQL. -->
    <add name="NovaTechIMS"
         connectionString="Host=localhost;Port=5432;Database=NovaTechIMS;Username=postgres;Password=YOUR_PASSWORD"
         providerName="Npgsql" />
  </connectionStrings>
</configuration>
