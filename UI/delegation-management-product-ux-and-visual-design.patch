+    "minWindowHeight": 768,
+    "badgeHeight": 20
+  }
+}
+```
+
+## 2.8 Icon Style Token
+
+```json
+{
+  "icon": { "style": "outline", "strokeWidth": "1.5-2px", "family": "single coherent outline set (Feather/Lucide-style)" }
+}
